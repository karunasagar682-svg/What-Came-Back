# WHAT CAME BACK - Environment Configuration
PROJECT_NAME="WHAT CAME BACK"
PROJECT_VERSION="1.0.0"

# Database Configuration
# Local SQLite default (out of the box demo)
DATABASE_URL=sqlite:///./what_came_back.db
# PostgreSQL production example:
# DATABASE_URL=postgresql://user:password@localhost:5432/what_came_back

# OpenAI API Configuration (Optional: fallback engine will run automatically if empty)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Business Thresholds
AGING_THRESHOLD_DAYS=7
EXPIRING_WINDOW_THRESHOLD_DAYS=7
HIGH_VALUE_THRESHOLD=1500.0
DEFECT_ANOMALY_PERCENTAGE=15.0
EXCESS_INVENTORY_DAYS=45
